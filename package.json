{
  "name": "antigravity-cli-motion",
  "version": "1.0.0",
  "description": "Motion graphics introduction for Antigravity CLI built with Remotion",
  "scripts": {
    "gen-audio": "node scripts/gen-audio.mjs",
    "build": "tsc --noEmit",
    "render": "remotion render src/index.ts AntigravityPromo out/antigravity_cli_promo.mp4",
    "still": "remotion still src/index.ts AntigravityPromo out/preview.png",
    "preview": "remotion preview src/index.ts"
  },
  "dependencies": {
    "@remotion/google-fonts": "^4.0.250",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.250"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.250",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
